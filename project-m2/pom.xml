<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
       <groupId>org.ujorm</groupId>
        <artifactId>main</artifactId>
        <version>3.0.0-RC5</version>
    </parent>

    <groupId>org.ujorm</groupId>
    <artifactId>ujo</artifactId>
    <version>3.0.0-RC5</version>
    <name>Module UJO Projects</name>
    <packaging>pom</packaging>
    <description>Ujorm common project</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- The default profile is "common" -->
    <profiles>
        <profile>
            <id>common</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <modules>
                <module>ujo-tools</module>
                <module>ujo-core</module>
                <module>ujo-converter</module>
                <module>ujo-orm</module>
                <module>ujo-web</module>
                <module>ujo-arangodb</module>
                <module>ujorm-meta-processor</module>
            </modules>
        </profile>

        <profile>
            <id>production</id>
            <modules>
                <module>ujo-tools</module>
                <module>ujo-core</module>
                <module>ujo-web</module>
                <module>ujo-orm</module>
                <module>ujo-converter</module>
                <module>ujorm-meta-processor</module>
            </modules>
        </profile>
    </profiles>

</project>
